# 公開するものだけを列挙する。ここにないファイルはすべて無視される。
# 新しく公開したいファイルは、下に `!` の行を足す。
/*
!/.gitignore
!/.python-version
!/pyproject.toml
!/uv.lock
!/README.md

!/bouncing/
/bouncing/*
!/bouncing/*.py
!/bouncing/models/
!/bouncing/figures/

# Python-generated files
__pycache__/
*.py[oc]

# 公開しない .py（bouncing/*.py の例外）
/bouncing/jev_probe.py
/bouncing/plot_jev.py
